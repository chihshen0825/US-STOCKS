<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">
  <!--<targets async="true">
    -->
  <!-- fileName="${basedir}/App_Data/Logs/${shortdate}/${logger}.txt" -->
  <!--
    <target name="file" xsi:type="File" fileName="${basedir}/Logs/${shortdate}.txt" />
  </targets>-->
  <targets>
    <target name="Watch_MLApi_Adv2Log"
            type="File"
            deleteOldFileOnStartup ="false"
            layout="${longdate}|${level}|${threadid}|${message}|${stacktrace}"
            
            fileName="${basedir}/Log/MLApi_Adv2Log_${date:format=yyyMMdd}.log"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="Big5"
            />

    <target name="Watch_TechAnalysisAPI"
        type="File"
        deleteOldFileOnStartup ="false"
        layout="${longdate}|${level}|${threadid}|${message}|${stacktrace}"
            
        fileName="${basedir}/Log/TechAnalysisAPI_${date:format=yyyMMdd}.log"
        concurrentWrites="true"
        keepFileOpen="false"
        encoding="Big5"
            />
  </targets>
  <rules>
    <!--<logger name="*" minlevel="Debug" writeTo="file" />-->
    <logger name="MLApi_Adv2Log" minlevel="Trace" writeTo="Watch_MLApi_Adv2Log" final ="true" />
    <logger name="TechAnalysisAPI_Log" minlevel="Trace" writeTo="Watch_TechAnalysisAPI" final ="true" />
  </rules>
</nlog>

<!--fileName="${basedir}/Log/${date:format=yyMMdd}/${date:format=HH}.txt"-->

