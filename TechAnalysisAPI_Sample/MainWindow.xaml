<Window x:Class="TechAnalysisAPI_Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TechAnalysisAPI_Sample"
        mc:Ignorable="d"        
        Title="MainWindow" Height="600" Width="1200">

    <Grid>
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="2"/>
                <Setter Property="MinWidth" Value="66"/>
                <Setter Property="Focusable" Value="False"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Label Content="身份證字號"/>
            <TextBox Name="edtID" Text="" MinWidth="150"/>
            <Label Content="密碼"/>
            <PasswordBox Name="edtPwd" Password="" MinWidth="150"/>
            <Button Name="btnDoLogin" Content="登 入" Click="btnDoLogin_Click"/>
        </StackPanel>
        
        <TabControl Grid.Row="1" Margin="0,3,0,0" Name="tbcMain" IsEnabled="False">
            <TabItem Header="指標">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Background="LightGray">

                            <StackPanel Orientation="Horizontal" Margin="8">
                                <!--商品名稱-->
                                <StackPanel >
                                    <Label Content="商品名稱:" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.114,1.49" />
                                    <TextBox x:Name="edtSymbol" HorizontalAlignment="Left" Height="23" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" />
                                </StackPanel>
                                <!--日期選項-->
                                <StackPanel >
                                    <Label Content="日期" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.114,1.49" />
                                    <ComboBox x:Name="cbDate" HorizontalAlignment="Left"  VerticalAlignment="Top" Width="85" SelectedIndex="0">
                                        <ComboBoxItem Content="當日" />
                                        <ComboBoxItem Content="起始日期"/>
                                        <ComboBoxItem Content="5"/>
                                    </ComboBox>
                                </StackPanel>
                                <!--歷史日期輸入-->
                                <StackPanel >
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=cbDate, Path=SelectedIndex}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Label Content="" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.114,1.49" />
                                    <TextBox Name="edtDateStart" Text="" Width="{Binding ElementName=edtSymbol, Path=ActualWidth}" Height="{Binding ElementName=edtSymbol, Path=ActualHeight}"/>
                                </StackPanel>
                                <!--分K選項-->
                                <StackPanel >
                                    <Label Content="分K" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.114,1.49" />
                                    <ComboBox x:Name="cbNK" HorizontalAlignment="Left"  VerticalAlignment="Top" Width="120" />
                                </StackPanel>
                                <!--指標選項-->
                                <StackPanel >
                                    <Label Content="指標" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.114,1.49" />
                                    <ComboBox x:Name="cbTAType" HorizontalAlignment="Left"  VerticalAlignment="Top" Width="120" Grid.Column="1" SelectionChanged="cbTAType_SelectionChanged"/>
                                </StackPanel>
                            </StackPanel>
                            <!--指標的參數-->
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <ListBox Name="lbTAParamList" HorizontalContentAlignment="Stretch" >
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ProName}" />
                                                <TextBox Grid.Column="1" Text="{Binding ProValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="1"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <Button x:Name="btnSubTA" Content="訂閱" Margin="0,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Click="btnSubTA_Click"/>
                                <Button x:Name="btn_UnSubTA" Content="取消訂閱" HorizontalAlignment="Left" VerticalAlignment="Top" Width="105" Click="btn_UnSubTA_Click" />
                            </StackPanel>

                        </StackPanel>

                    </Grid>

                    <Grid Grid.Row="1" Background="LightGray" >
                        <TextBox x:Name="tbx_ErrorMsg" Margin="10" TextWrapping="NoWrap" Style="{Binding this.style}" IsReadOnly="True"/>
                    </Grid>

                    <Grid Grid.Row="2" Background="LightGray" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="1" x:Name="tbx_Msg" Margin="10" HorizontalAlignment="Stretch" TextWrapping="NoWrap"  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" BorderBrush="Transparent"/>
                    </Grid>

                </Grid>
            </TabItem>

            <TabItem Header="歷史成交(不含今日)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Background="LightGray">

                            <StackPanel Orientation="Horizontal" Margin="8">
                                <!--商品名稱-->
                                <StackPanel >
                                    <Label Content="商品名稱:" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.114,1.49" />
                                    <TextBox x:Name="edtBS_Symbol" HorizontalAlignment="Left" Height="23" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" />
                                </StackPanel>
                                <!--歷史日期輸入-->
                                <StackPanel >
                                    <Label Content="日期" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.114,1.49" />
                                    <TextBox Name="edtBS_Date" Text="" Width="{Binding ElementName=edtBS_Symbol, Path=ActualWidth}" Height="{Binding ElementName=edtBS_Symbol, Path=ActualHeight}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <Button x:Name="btnSubBS" Content="載入" Margin="0,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Click="btnSubBS_Click"/>
                            </StackPanel>

                        </StackPanel>

                    </Grid>

                    <Grid Grid.Row="1" Background="LightGray" >
                        <TextBox x:Name="tbxBS_ErrorMsg" Margin="10" TextWrapping="NoWrap" Style="{Binding this.style}" IsReadOnly="True"/>
                    </Grid>

                    <Grid Grid.Row="2" Background="LightGray" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="1" x:Name="tbx_BS_Msg" Margin="10" HorizontalAlignment="Stretch" TextWrapping="NoWrap"  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" BorderBrush="Transparent"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
